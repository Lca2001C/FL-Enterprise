# Vite dev — copie para .env.local
VITE_API_BASE_URL=http://localhost:8000
# Payment Brick (opcional; senão vem de GET /api/v1/config/payments)
VITE_MERCADOPAGO_PUBLIC_KEY=
# Realtime (Socket.IO): só habilite com a API em asgi:app + WebSocket (host único /
# docker-compose). Em Vercel+Render deixe vazio/false (sem WebSocket).
VITE_ENABLE_REALTIME=false
